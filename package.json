{
  "name": "optchat-app",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/desktop/main.js",
  "description": "A desktop app for pi-optchat: one chat per profile, with its memory, windows and agents visible.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "start": "vite build && node src/server/main.ts",
    "server": "node src/server/main.ts",
    "check": "tsc --noEmit && tsc --noEmit -p src/ui",
    "test": "node --test --test-timeout=60000 test/*.test.ts",
    "test:live": "node --test test/live.ts",
    "test:ui": "node --test --test-timeout=120000 test/ui.ts",
    "screenshots": "node scripts/screenshots.ts",
    "build:desktop": "vite build && vite build -c vite.desktop.config.ts",
    "desktop": "npm run build:desktop && electron .",
    "dist": "npm run build:desktop && electron-builder --mac --publish never"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "pi-optchat": "^0.11.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "typebox": "1.3.27",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
